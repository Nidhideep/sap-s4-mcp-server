# SAP S/4HANA OData connection
# Full URL including scheme and port, e.g. https://my-s4.example.com:44301
S4_ODATA_HOST=https://your-s4-system.example.com:44301

# SAP client number (default: 100)
S4_ODATA_CLIENT=100

# Auth method: basic (recommended for on-prem) or token (recommended for BTP)
AUTH_METHOD=basic

# Basic auth (used when AUTH_METHOD=basic)
S4_ODATA_USER=your_username
S4_ODATA_PASSWORD=your_password

# Bearer token (used when AUTH_METHOD=token)
# S4_ODATA_TOKEN=your_bearer_token

# Operational
LOG_LEVEL=info

# Set to true to block all write operations (safe for read-only testing)
DRY_RUN=false
