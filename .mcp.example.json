{
  "_comment": "Copy to .mcp.json and fill in real values. Never commit .mcp.json.",
  "mcpServers": {
    "sap-s4-mcp-server": {
      "command": "node",
      "args": ["/absolute/path/to/sap-s4-mcp-server/dist/src/index.js"],
      "env": {
        "S4_ODATA_HOST": "https://your-s4-system.example.com:44301",
        "S4_ODATA_CLIENT": "100",
        "AUTH_METHOD": "basic",
        "S4_ODATA_USER": "your_username",
        "S4_ODATA_PASSWORD": "your_password",
        "LOG_LEVEL": "info",
        "DRY_RUN": "false"
      }
    }
  }
}
